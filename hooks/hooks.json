{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "rust-script $CLAUDE_PLUGIN_ROOT/hooks/scripts/session-start.rs",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/pre-agent-task-context.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run agent-governance",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/pre-commit-gate.nu",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/pre-skill-trace.nu",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PLUGIN_ROOT/hooks/scripts/check-blocked.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-json-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-toml-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-yaml-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-nu-check.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "rust-script $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-write-plan-ingest.rs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-json-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-toml-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-yaml-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-nu-check.nu",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-skill-trace.nu",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-skill-trace.nu",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "godmode hook run stop-guard",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
