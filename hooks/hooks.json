{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "godmode handon",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PLUGIN_ROOT/hooks/scripts/check-blocked.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Run `godmode task list --json` and check for tasks with status 'running'. Respond with JSON only: {\"decision\":\"block\",\"reason\":\"<task ids still running>\"} if any tasks are running, or {\"decision\":\"approve\"} if none are.",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
