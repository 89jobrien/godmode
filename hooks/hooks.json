{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "rust-script $CLAUDE_PLUGIN_ROOT/hooks/scripts/session-start.rs",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "godmode hook run task-management",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run using-godmode",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run memory-banking",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/pre-agent-task-context.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run agent-governance",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/pre-bash-nag.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/pre-commit-gate.nu",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "godmode hook run task-driven-development",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run moa",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "godmode hook run brainstorm",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run design",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run testing-philosophy",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "godmode hook run refactoring",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run receiving-review",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run context-map",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run rust-conventions",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PLUGIN_ROOT/hooks/scripts/check-blocked.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run parallel-agents",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/task-done-sync.nu",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "godmode hook run auto-block",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run systematic-debugging",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run ci-fix",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "godmode hook run cap",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run code-review",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run tackle-issues",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run wave-integration",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run observability-as-infrastructure",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run doublecheck",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run merge",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run todo-issue-sync",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-json-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-toml-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-yaml-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-nu-check.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run writing-plans",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "rust-script $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-write-plan-ingest.rs",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "godmode hook run mini-context-graph",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-json-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-toml-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-yaml-validate.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/post-nu-check.nu",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "godmode hook run stop-guard",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "nu $CLAUDE_PLUGIN_ROOT/hooks/scripts/memory-bank-update-remind.nu",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "godmode hook run verification-before-completion",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "godmode hook run introspection",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
