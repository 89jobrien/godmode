#!/usr/bin/env rust-script
//! CAS (content-addressable storage) helper for the dialectic MoA pipeline.
//!
//! Keyed by sha256 of the question text. Entries live under:
//!   <repo-root>/.ctx/moa/cas/<hash>/
//!
//! Named symlinks in .ctx/moa/ always point to the current HEAD entry.
//!
//! ```cargo
//! [dependencies]
//! clap      = { version = "4", features = ["derive"] }
//! hex       = "0.4"
//! serde     = { version = "1", features = ["derive"] }
//! serde_json = "1"
//! sha2      = "0.10"
//! ```

use clap::{Parser, Subcommand};
use sha2::{Digest, Sha256};
use std::{
    fs,
    os::unix::fs::symlink,
    path::{Path, PathBuf},
    process,
};

const AGENTS: &[&str] = &["advocate", "skeptic", "alternative", "synthesis"];

#[derive(Parser)]
#[command(name = "moa-cas", about = "CAS store for dialectic MoA proposals")]
struct Cli {
    #[command(subcommand)]
    cmd: Cmd,
}

#[derive(Subcommand)]
enum Cmd {
    /// Print the 16-char hash for a question string
    Hash { question: String },

    /// Check if a CAS entry is complete (all agent files present). Exit 0=hit, 1=miss.
    Check { hash: String },

    /// Create the CAS directory and write meta.json for a new entry
    Init {
        hash: String,
        #[arg(long)]
        question: String,
        /// JSON object of agent→model mappings, e.g. '{"advocate":"claude-sonnet-4-6"}'
        #[arg(long, default_value = "{}")]
        models: String,
    },

    /// Print the absolute path for an agent's proposal file within a CAS entry
    Path { hash: String, agent: String },

    /// Repoint .ctx/moa/<agent>.txt symlinks to cas/<hash>/ and write HEAD
    Link { hash: String },

    /// Delete a CAS entry (cache invalidation / --fresh)
    Fresh { hash: String },

    /// Print HEAD hash and its meta.json
    Show,
}

fn repo_root() -> PathBuf {
    let out = process::Command::new("git")
        .args(["rev-parse", "--show-toplevel"])
        .output()
        .expect("git not found");
    PathBuf::from(String::from_utf8(out.stdout).unwrap().trim())
}

fn moa_dir(root: &Path) -> PathBuf {
    root.join(".ctx/moa")
}

fn cas_dir(root: &Path, hash: &str) -> PathBuf {
    moa_dir(root).join("cas").join(hash)
}

fn hash_question(question: &str) -> String {
    let mut h = Sha256::new();
    h.update(question.as_bytes());
    hex::encode(h.finalize())[..16].to_string()
}

fn main() {
    let cli = Cli::parse();
    let root = repo_root();

    match cli.cmd {
        Cmd::Hash { question } => {
            println!("{}", hash_question(&question));
        }

        Cmd::Check { hash } => {
            let dir = cas_dir(&root, &hash);
            let complete = AGENTS
                .iter()
                .all(|a| dir.join(format!("{a}.txt")).is_file());
            process::exit(if complete { 0 } else { 1 });
        }

        Cmd::Init { hash, question, models } => {
            let dir = cas_dir(&root, &hash);
            fs::create_dir_all(&dir).unwrap();

            let models_val: serde_json::Value =
                serde_json::from_str(&models).unwrap_or(serde_json::json!({}));

            let meta = serde_json::json!({
                "hash":      hash,
                "question":  question,
                "timestamp": std::time::SystemTime::now()
                    .duration_since(std::time::UNIX_EPOCH)
                    .unwrap()
                    .as_secs(),
                "models":    models_val,
            });

            fs::write(
                dir.join("meta.json"),
                serde_json::to_string_pretty(&meta).unwrap(),
            )
            .unwrap();

            println!("{}", dir.display());
        }

        Cmd::Path { hash, agent } => {
            println!("{}", cas_dir(&root, &hash).join(format!("{agent}.txt")).display());
        }

        Cmd::Link { hash } => {
            let moa = moa_dir(&root);
            fs::create_dir_all(&moa).unwrap();

            let cas = cas_dir(&root, &hash);
            if !cas.exists() {
                eprintln!("error: CAS entry {hash} does not exist");
                process::exit(1);
            }

            for agent in AGENTS {
                let link = moa.join(format!("{agent}.txt"));
                let target = cas.join(format!("{agent}.txt"));
                if link.exists() || link.is_symlink() {
                    fs::remove_file(&link).unwrap();
                }
                symlink(&target, &link).unwrap();
            }

            fs::write(moa.join("HEAD"), &hash).unwrap();
            println!("{hash}");
        }

        Cmd::Fresh { hash } => {
            let dir = cas_dir(&root, &hash);
            if dir.exists() {
                fs::remove_dir_all(&dir).unwrap();
                println!("removed {}", dir.display());
            } else {
                println!("nothing to remove for {hash}");
            }
        }

        Cmd::Show => {
            let moa = moa_dir(&root);
            let head_path = moa.join("HEAD");
            if !head_path.exists() {
                println!("no HEAD");
                process::exit(0);
            }
            let hash = fs::read_to_string(&head_path).unwrap();
            let hash = hash.trim();
            let meta_path = cas_dir(&root, hash).join("meta.json");
            if meta_path.exists() {
                println!("{}", fs::read_to_string(meta_path).unwrap());
            } else {
                println!("HEAD={hash} (no meta.json)");
            }
        }
    }
}
